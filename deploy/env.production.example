# TirraMind — PRODUCTION secrets, for the internet-facing VM only.
#
# This is deliberately NOT the same file as the dev .env at the repo root.
# That file also holds WANDB_API_KEY, HF_TOKEN, GITHUB_TOKEN, KAGGLE_API_TOKEN,
# and TIRRA_LLM_API_KEY (Anthropic) — training/CI credentials that have no
# business being reachable from a process exposed to the public internet.
# Copy THIS file to /opt/tirramind/.env.production on the VM; every systemd
# unit under deploy/systemd/ points its EnvironmentFile there, not at .env.
#
# Every variable below was confirmed by grepping actual `os.getenv`/
# `os.environ` calls in agent/brief_server.py, agent/payments/*.py, and
# scripts/{tirra_engine,run_chain,run_collection}.py — nothing here is guessed.

# ── Paddle (payments) ──────────────────────────────────────────────────────
TIRRA_PADDLE_MODE=live
TIRRA_PADDLE_API_KEY=
TIRRA_PADDLE_CLIENT_TOKEN=
TIRRA_PADDLE_WEBHOOK_SECRET=
TIRRA_PADDLE_PRICE_ID=
# TIRRA_PADDLE_RETAIN_ID=

# Set after running scripts/setup_paddle_products.py (it has no --mode flag —
# it targets whichever TIRRA_PADDLE_MODE/TIRRA_PADDLE_API_KEY are set in the
# environment it runs in, e.g. `TIRRA_PADDLE_MODE=live TIRRA_PADDLE_API_KEY=...
# .venv/bin/python scripts/setup_paddle_products.py`). That run also patches
# PADDLE_ENV, PADDLE_CLIENT_TOKEN, and TIER_PRICE_IDS directly in
# products/brief_subscription/pricing.html — re-run it any time the mode or
# catalog changes, it's idempotent:
# TIRRA_TIER_PRICE_MAP=pri_xxx:data,pri_yyy:entity,pri_zzz:scheduler,pri_www:brief

# ── Access control ─────────────────────────────────────────────────────────
# MUST be 1 in production. Without it, `_authorized_for` treats "no credentials
# configured" as dev mode and serves EVERY paid tier to anonymous callers — so
# an env file that is missing, truncated, or (as this template ships) has empty
# auth values silently converts the whole paid API into a free one. With it set,
# no credentials means nobody gets in.
TIRRA_REQUIRE_AUTH=1

# Static admin/dev bypass keys (comma-separated). Leave unset once Paddle is
# the only auth path — see agent/brief_server.py::_authorized_for.
# TIRRA_SUB_KEYS=

# Shared secret required on POST /evidence/ingest (X-Ingest-Token header).
# MUST be set in production. With TIRRA_REQUIRE_AUTH=1 an empty value now
# denies all ingest (fails closed); without it, an empty value serves ingest
# OPEN. Generate with: openssl rand -hex 32
TIRRA_INGEST_TOKEN=

# Optional base directory for POST /evidence/ingest "path" mode. Path ingest
# is REFUSED unless this is set, and the resolved realpath must sit inside
# it — this is what confines the ingest file read. Leave unset unless you
# specifically need to ingest files from disk over HTTP; "text" mode is
# unaffected. See docs/research/evidence_ingest_path_traversal.md.
# TIRRA_INGEST_DIR=/opt/tirramind/ingest

# Fallback "buy" redirect if the Paddle.js overlay checkout isn't reachable
# for some reason. Per-tier override: TIRRA_BUY_URL_<TIER>.
# TIRRA_BUY_URL=

# ── Data sources used by the nightly chain (deploy/systemd/tirra-chain.*) ──
TIRRA_FRED_API_KEY=
TIRRA_NASA_FIRMS_KEY=
FIRMS_API_KEY=
TIRRA_EIA_API_KEY=

# Optional — every one of these degrades gracefully (source skipped or run in
# a rate-limited/keyless mode) rather than crashing the chain if left unset.
# All are free-tier signups; set them to widen collection coverage.
# TIRRA_FEC_API_KEY=            # falls back to the shared DEMO_KEY (low rate limit)
# TIRRA_LDA_API_KEY=            # Senate LDA lobbying filings
# TIRRA_UN_COMTRADE_KEY=        # premium tier of the free preview endpoint
# TIRRA_COMPANIES_HOUSE_KEY=    # UK Companies House charges (creditor_filings uk_charges)
# TIRRA_USPTO_API_KEY=          # USPTO ODP — no keyless tier; register at
#                               # https://data.uspto.gov/apis/getting-started

# ── Pipeline paths (defaults shown; override only if your layout differs) ──
# TIRRA_PIPELINE_DB=.tirra_pipeline/pipeline.db
# TIRRA_PIPELINE_WORKERS=4

# ── Optional: brief delivery by email (tirra_engine.py --once path) ────────
# TIRRA_SMTP_HOST=
# TIRRA_SMTP_PORT=587
# TIRRA_SMTP_USER=
# TIRRA_SMTP_PASS=
# TIRRA_SMTP_FROM=
# TIRRA_BRIEF_TO=
