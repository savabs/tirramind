[Unit]
Description=Run tirra-chain.service weekdays at 18:00 UTC

[Timer]
# 18:00 UTC matches daily_collection's own declared schedule
# ("0 18 * * 1-5" — after US market close, CFTC/FINRA publish windows).
# The chain then runs every downstream DAG in dependency order rather than
# relying on each DAG's individual cron, which only fires under a long-running
# scheduler process that production never started.
OnCalendar=Mon..Fri 18:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
