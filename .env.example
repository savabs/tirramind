# TirraMind Agent — Environment Variables
# Copy to .env and fill in your values.

# LLM Provider: "openai", "ollama", or "claude"
TIRRA_LLM_PROVIDER=claude

# Model name (e.g. gpt-4o, gpt-4o-mini, llama3, claude-haiku-3-5-20241022)
TIRRA_LLM_MODEL=claude-haiku-3-5-20241022

# API key (required for OpenAI/Claude, not needed for Ollama)
TIRRA_LLM_API_KEY=your-anthropic-api-key-here

# Custom endpoint (optional — set for Ollama or Azure)
# TIRRA_LLM_BASE_URL=http://localhost:11434/v1

# FRED API key (free — https://fred.stlouisfed.org/docs/api/api_key.html)
TIRRA_FRED_API_KEY=your-fred-key-here

# Agent settings
# TIRRA_MAX_STEPS=30
# TIRRA_MAX_PLAN_DEPTH=3
# TIRRA_MEMORY_DIR=.tirra_memory
