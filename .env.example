# TirraMind Agent — Environment Variables
# Copy to .env and fill in your values.

# LLM Provider: "openai", "ollama", or "claude"
TIRRA_LLM_PROVIDER=claude

# Model name (e.g. gpt-4o, gpt-4o-mini, llama3, claude-haiku-3-5-20241022)
TIRRA_LLM_MODEL=claude-haiku-3-5-20241022

# API key (required for OpenAI/Claude, not needed for Ollama)
TIRRA_LLM_API_KEY=your-anthropic-api-key-here

# Custom endpoint (optional — set for Ollama or Azure)
# TIRRA_LLM_BASE_URL=http://localhost:11434/v1

# FRED API key (free — https://fred.stlouisfed.org/docs/api/api_key.html)
TIRRA_FRED_API_KEY=your-fred-key-here

# ── Free API keys for otherwise-dark sources ──────────────────────────────────
# Both are free, instant, and unblock 4 of the 54 daily_collection sources.
# Without them those tools fail every run (they check the key and bail).

# NASA FIRMS — active fire / thermal anomaly detection.
# Register: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unblocks: agent/tools/satellite_activity.py  (mode="fire")
TIRRA_NASA_FIRMS_KEY=

# EIA (US Energy Information Administration) — electricity + energy supply.
# Register: https://www.eia.gov/opendata/register.php
# Unblocks: agent/tools/electricity_monitor.py, interconnection_queue.py,
#           energy_supply.py  (energy_supply falls back to DEMO_KEY, which is
#           heavily rate-limited — set a real key.)
TIRRA_EIA_API_KEY=

# Optional second FIRMS consumer (agent/tools/nightlight_activity.py) reads
# FIRMS_API_KEY rather than TIRRA_NASA_FIRMS_KEY. Set both to the same value.
FIRMS_API_KEY=

# Ghost pattern public archive — dedicated @dry-clean GitHub account
# GH_USER=dry-clean
# GH_ARCHIVE_REPO=tirramind-ghost-archive
# DRY_CLEAN_GITHUB_TOKEN=ghp_...  # repo scope on dry-clean account

# Agent settings
# TIRRA_MAX_STEPS=30
# TIRRA_MAX_PLAN_DEPTH=3
# TIRRA_MEMORY_DIR=.tirra_memory

# ── Paddle payments (Opportunity Brief subscription) ──────────────────────────
# Mode: sandbox (default) | live. Sandbox→live migration = change MODE + keys/IDs.
TIRRA_PADDLE_MODE=sandbox
# Server-side API key (Developer Tools > Authentication). Different per mode.
TIRRA_PADDLE_API_KEY=your-api-key-here
# Client-side token (test_ for sandbox, live_ for live). Used by checkout.
TIRRA_PADDLE_CLIENT_TOKEN=test_your-client-token
# Notification destination endpoint_secret_key (signature verification).
# REQUIRED in live mode. Retrieve once when creating the destination.
TIRRA_PADDLE_WEBHOOK_SECRET=
# The checkout price ID (pri_...) to buy the brief.
TIRRA_PADDLE_PRICE_ID=pri_your-price-id
# Optional: Retain customer id (ctm_...) for pwCustomer on Paddle.Initialize.
TIRRA_PADDLE_RETAIN_ID=
# Optional: seconds of grace access after subscription.past_due before
# revoking (a failed card is not a cancellation). Default 259200 (3 days).
# TIRRA_PAST_DUE_GRACE_S=259200

# ── Brief server / checkout ──────────────────────────────────────────────────
# Hosted checkout URL (Paddle checkout link / payment link) for /buy.
TIRRA_BUY_URL=
# Static subscriber keys (dev fallback); live uses Paddle webhook store instead.
TIRRA_SUB_KEYS=
# Landing page HTML path.
TIRRA_LANDING_HTML=products/brief_subscription/index.html
