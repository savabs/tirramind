# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Environment
.env
.venv/
venv/

# VS Code MCP config (contains API keys)
.vscode/mcp.json

# Cursor MCP config (copy from .cursor/mcp.json.example via make mcp-setup)
.cursor/mcp.json

# Cursor hook runtime logs (hooks.json is tracked)
.cursor/logs/

# TirraMind memory persistence
.tirra_memory/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local runtime/cache artifacts
.pytest_cache/
.tirra_cache/
.tirra_pipeline/

# Documentation and workflow artifacts
# NOTE: *.md, docs/, tasks/ are intentionally NOT excluded — they are the
# project knowledge base and must be readable by AI coding assistants.
# Only secrets and runtime artifacts belong in .gitignore.
# .github/ excluded from ignore — workflows must be tracked for GitHub Actions to run
!.github/
!.github/**
# .claude/skills/ — Claude agent skills must be tracked (skill SKILL.md files)
!.claude/
!.claude/**

# Media and miscellaneous local files
*.jpeg
*.jpg
*.png
<MagicMock*
=0.2
*.json
*.log
*.csv
*.pkl
*.txt

# Kaggle-downloaded DB snapshot — exceeds GitHub's 100MB hard file-size limit
# and isn't the live app's database anyway (that's the separate, already-
# ignored .tirra_pipeline/pipeline.db). Removed from history in this commit.
kaggle_downloads/tirramind-data/pipeline.db

# The blanket *.json rule above (meant for stray data/log artifacts) also
# caught .claude/settings.json — the shared hook wiring (guard-protected-files,
# warn-schema-drift, lint-python, session-start-team-roster) has never been
# committed as a result. .claude/settings.local.json stays ignored — that one
# is genuinely per-machine (e.g. prefersReducedMotion).
!.claude/settings.json

# AWOS runtime state
.awos/
tirramind_data_upload.zip
tirramind_code.zip

# Auto-research paper cache
knowledge/*.tar.gz
knowledge/*.tar

# Test SQLite leakage (MagicMock db_path files that land in project root)
<MagicMock*
# Root-level log files (use logs/ dir instead)
*.log
# Old upload zips (tirramind_data_upload.zip and tirramind_code.zip tracked explicitly)
tirramind_hg_upload.zip
tirramind_listnet_upload.zip
# Nested project copy (from Kaggle output extraction)
tirramind_v1/

# Runtime state (brief delivery + learned probabilities)
.tirra_delivery/
.tirra_opportunities/

# Claude Code runtime lock (not project config — .claude/CLAUDE.md IS tracked)
.claude/scheduled_tasks.lock

# Production secrets. The bare `.env` rule above does NOT cover these — they
# live inside the git clone at /opt/tirramind by design (systemd EnvironmentFile
# needs a stable path), so without these lines a routine `git add -A` on the
# server commits live Paddle credentials and R2 write keys.
# `.example` templates are deliberately still tracked.
.env.production
.env.backup
.env.*.local
!.env*.example
